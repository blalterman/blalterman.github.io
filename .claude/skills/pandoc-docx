#!/bin/bash
# Claude Code Skill: pandoc-docx
# Convert markdown to .docx using pandoc with NASA reference template
# Usage: /pandoc-docx <input.md> [output.docx]

set -e

# Parse arguments
INPUT_FILE="$1"
OUTPUT_FILE="${2:-${INPUT_FILE%.md}.docx}"

# Validate input
if [[ -z "$INPUT_FILE" ]]; then
    echo "❌ Error: No input file specified"
    echo "Usage: /pandoc-docx <input.md> [output.docx]"
    exit 1
fi

if [[ ! -f "$INPUT_FILE" ]]; then
    echo "❌ Error: Input file '$INPUT_FILE' not found"
    exit 1
fi

# Find pandoc in the docx-conversion conda env (install prefix varies by machine)
PANDOC_PATH=""
for prefix in /opt/anaconda3 /opt/miniconda3 "$HOME/anaconda3" "$HOME/miniconda3"; do
    if [[ -x "$prefix/envs/docx-conversion/bin/pandoc" ]]; then
        PANDOC_PATH="$prefix/envs/docx-conversion/bin/pandoc"
        break
    fi
done
if [[ -z "$PANDOC_PATH" ]]; then
    echo "❌ Error: pandoc not found in any docx-conversion conda env"
    echo "Checked /opt/anaconda3, /opt/miniconda3, ~/anaconda3, ~/miniconda3"
    exit 1
fi
# rsvg-convert (SVG embedding) lives in the same env
export PATH="$(dirname "$PANDOC_PATH"):$PATH"

# Find reference template
TEMPLATE="nasa-reference-template.docx"
if [[ ! -f "$TEMPLATE" ]]; then
    echo "⚠️  Warning: nasa-reference-template.docx not found in current directory"
    echo "Proceeding without reference template..."
    TEMPLATE_ARG=""
else
    TEMPLATE_ARG="--reference-doc=$TEMPLATE"
    echo "✓ Using template: $TEMPLATE"
fi

# Run conversion
echo "Converting $INPUT_FILE → $OUTPUT_FILE"
# Image links are relative to the markdown file, so resolve them from its directory
"$PANDOC_PATH" "$INPUT_FILE" -o "$OUTPUT_FILE" $TEMPLATE_ARG --resource-path="$(dirname "$INPUT_FILE"):."

# Verify output
if [[ -f "$OUTPUT_FILE" ]]; then
    SIZE=$(ls -lh "$OUTPUT_FILE" | awk '{print $5}')
    echo "✅ Success! Created $OUTPUT_FILE ($SIZE)"
    echo "Type: $(file -b "$OUTPUT_FILE")"
else
    echo "❌ Error: Output file not created"
    exit 1
fi
